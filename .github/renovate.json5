{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // Config for Renovate, which raises the pull requests that keep this
  // repository's dependencies current and merges the ones that pass. Nothing
  // here runs locally: the hosted app has to be installed on the repository
  // before any of it takes effect.
  //
  // Two things shape every rule below. The first is that both CI jobs run on
  // `macos-latest`, because `src/proc.rs` refuses to compile anywhere else —
  // and GitHub bills a macOS minute at ten times a Linux one. Every pull
  // request raised here costs two of those jobs, so the grouping and the
  // schedule are not tidiness, they are the bill. The second is that nothing
  // in CI opens a selector: `tests/cli.rs` says so in its own header, and it
  // is why the crates that draw one are the ones a human still looks at.
  extends: [
    "config:recommended",
    // ci.yml and release-plz.yml already pin every action by commit SHA. This
    // keeps them pinned rather than letting a bump write a floating tag back.
    "helpers:pinGitHubActionDigests",
  ],

  timezone: "Europe/Oslo",

  // Weekly, rather than whenever a release happens. What is actually wanted is
  // one batch of pull requests to glance at, not a queue arriving through the
  // week — and each one that arrives spends two macOS jobs whether or not
  // anybody was going to look at it that day.
  schedule: ["* 0-6 * * 1"],

  // Nothing is merged until it has been published for three days. Most of what
  // a bad release does to its dependents it does within hours, and a yanked
  // version never reaches here at all.
  minimumReleaseAge: "3 days",
  // Load-bearing beside the line above: without `strict`, an update still too
  // young to merge is raised as a pull request that simply waits, which is the
  // pull request the schedule exists to avoid. With it, the update is held
  // back entirely until it is old enough.
  internalChecksFilter: "strict",

  // Merged by GitHub itself once the required checks report, which is the same
  // `gh pr merge --squash --auto` a maintainer arms by hand — and squash,
  // because that is how everything lands on `main` here.
  automerge: true,
  automergeType: "pr",
  platformAutomerge: true,
  automergeStrategy: "squash",

  // The ruleset on `main` is strict, so a branch behind it cannot merge and
  // auto-merge would sit armed and never fire. This is what keeps the branch
  // current enough for GitHub to act on.
  rebaseWhen: "behind-base-branch",

  // Commit subjects here are prose, not conventional commits — see
  // release-plz.toml, which reads a `Release:` line and nothing else.
  semanticCommits: "disabled",

  // A handful at a time. The limits matter more than usual: an unattended
  // fleet of pull requests against macOS runners is a bill rather than a
  // backlog.
  prConcurrentLimit: 3,
  prHourlyLimit: 2,

  // A monthly refresh of Cargo.lock, for the transitive dependencies that
  // never move a version in Cargo.toml. Its own pull request by construction,
  // so it is kept well away from the weekly batch.
  lockFileMaintenance: {
    enabled: true,
    schedule: ["* 0-6 1 * *"],
  },

  packageRules: [
    {
      description: "release.yml is generated by dist. Editing it is a change that the next `dist init` reverts without telling anyone — the actions in it move when dist-workspace.toml pins a new dist and someone runs that command.",
      matchFileNames: [".github/workflows/release.yml"],
      enabled: false,
    },
    {
      description: "Everything from crates.io in one pull request, so a week of dependency churn is one build rather than eleven.",
      matchManagers: ["cargo"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "rust crates",
    },
    {
      description: "A major crate release changes an API on purpose. Its own pull request, and a human reads the changelog before it lands.",
      matchManagers: ["cargo"],
      matchUpdateTypes: ["major"],
      automerge: false,
    },
    {
      description: "The two crates that draw the selector, which must move together: skim returns a ratatui `Line`, so a ratatui bump on its own is a build failure and a matched pair is an interactive surface no test in this repository exercises. Never merged unattended, at any update type.",
      matchDepNames: ["skim", "ratatui"],
      groupName: "selector (skim and ratatui)",
      automerge: false,
    },
    {
      description: "Workflow actions in one pull request. They move often and independently, and each one is a digest nobody reads.",
      matchManagers: ["github-actions"],
      groupName: "github actions",
    },
    {
      description: "The release-plz action and the release-plz CLI version pinned beside it in the same workflow. Bumping the action alone leaves the two disagreeing about which release-plz actually runs.",
      matchDepNames: ["release-plz/action", "release-plz"],
      groupName: "release-plz",
    },
    {
      description: "dist is pinned in two files that have to agree — mise.toml, for running `dist init` by hand, and dist-workspace.toml, which that command reads. Bumping them is not the whole change: .github/workflows/release.yml is generated from the old version until somebody runs `dist init` and commits the result, so this one is never merged unattended.",
      matchDepNames: ["cargo-dist"],
      groupName: "dist",
      automerge: false,
    },
    {
      description: "A toolchain bump is its own pull request: it rebuilds everything, and each Rust release brings clippy lints that `make lint` turns into build failures. Merged on green all the same — that failure is exactly what CI is for.",
      matchDepNames: ["rust"],
      groupName: "rust toolchain",
    },
  ],

  customManagers: [
    {
      description: "The Rust toolchain, which rustup reads directly from rust-toolchain.toml and no built-in manager covers.",
      customType: "regex",
      managerFilePatterns: ["/^rust-toolchain\\.toml$/"],
      matchStrings: ["channel\\s*=\\s*\"(?<currentValue>\\d+\\.\\d+(\\.\\d+)?)\""],
      depNameTemplate: "rust",
      packageNameTemplate: "rust-lang/rust",
      datasourceTemplate: "github-releases",
      versioningTemplate: "semver",
    },
    {
      description: "The dist that generates .github/workflows/release.yml. Read from crates.io, which is where the version mise resolves comes from too, so the two files are offered the same number.",
      customType: "regex",
      managerFilePatterns: ["/^dist-workspace\\.toml$/"],
      matchStrings: ["cargo-dist-version\\s*=\\s*\"(?<currentValue>[^\"]+)\""],
      depNameTemplate: "cargo-dist",
      datasourceTemplate: "crate",
    },
    {
      description: "A `# renovate:` comment above a pinned version, for a version that is an input to an action rather than a dependency of anything. release-plz.yml has two.",
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+version:\\s*\"(?<currentValue>[^\"]+)\"",
      ],
    },
  ],
}
